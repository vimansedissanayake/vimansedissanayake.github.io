---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base
  title="Writing"
  description="Essays on building production AI systems, agentic infrastructure, and starting things."
>
  <div class="container">
    <header class="page-head">
      <p class="label" data-reveal>Writing</p>
      <h1 data-reveal style="--i: 1">Notes from building AI systems that ship.</h1>
      <p data-reveal style="--i: 2">
        Agentic infrastructure, search at billion scale, and what I learn going from engineer to founder.
      </p>
    </header>
    <div data-reveal style="--i: 3">
      <PostList posts={posts} groupByYear />
    </div>
  </div>
</Base>

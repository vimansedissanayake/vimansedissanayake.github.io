---
interface Props {
  size?: number;
  title?: string;
}

const { size = 28, title } = Astro.props;
---

<svg
  class="logo"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <path d="M6 9.4 L52 9.4 C79 9.4 94 27.5 94 50 C94 72.5 79 90.6 52 90.6 L4 90.6 L4 90.2 L52 88.6 C74 88.6 84.5 71.5 84.5 50 C84.5 28.5 74 11.4 52 11.4 Z" />
  <path d="M16.5 10 L28.5 10 L49.2 73.5 L46.2 77.5 Z" />
  <path d="M45.4 75 L70.8 14.6 L73.4 15.2 L48 77.5 Z" />
  <path d="M25.6 34 L27.4 34 L30.6 89.4 L28.4 89.4 Z" />
</svg>

<style>
  .logo {
    flex: none;
    color: var(--fg);
  }
</style>
